{
  "name": "skolintegratoren",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "sim": "node scripts/run-sim.mjs",
    "e2e": "playwright test",
    "size-check": "node scripts/size-check.mjs",
    "gates": "npm run typecheck && npm test && npm run sim && npm run size-check && npm run tasks:check && npm run build && npm run e2e",
    "android:sync": "npm run build && cap sync android",
    "tasks:check": "node scripts/check-tasks.mjs",
    "tasks:next": "node scripts/next-task.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "break_infinity.js": "^2.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
